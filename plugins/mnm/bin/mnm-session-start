#!/usr/bin/env node

// src/session-start.ts
import { promises as fs } from "node:fs";
import { join } from "node:path";
import { pathToFileURL } from "node:url";
async function runSessionStart(params) {
  let currentVersion;
  try {
    const manifestPath = join(params.root, ".claude-plugin", "plugin.json");
    const manifest = JSON.parse(await fs.readFile(manifestPath, "utf8"));
    currentVersion = typeof manifest.version === "string" ? manifest.version : "unknown";
  } catch {
    return {
      hookSpecificOutput: {
        hookEventName: "SessionStart",
        additionalContext: ""
      }
    };
  }
  let state = null;
  try {
    const statePath = join(params.data, "last-session.json");
    state = JSON.parse(await fs.readFile(statePath, "utf8"));
  } catch {
  }
  if (state === null) {
    return {
      hookSpecificOutput: {
        hookEventName: "SessionStart",
        additionalContext: `MnM plugin v${currentVersion}. First run detected. To provision your workspace, ask: "Set me up for MnM".`
      }
    };
  }
  if (state.lastPluginVersion === currentVersion) {
    return {
      hookSpecificOutput: {
        hookEventName: "SessionStart",
        additionalContext: ""
      }
    };
  }
  return {
    hookSpecificOutput: {
      hookEventName: "SessionStart",
      additionalContext: `MnM plugin v${currentVersion}. Plugin updated from v${state.lastPluginVersion} \u2014 run "Set me up for MnM" to refresh agents.`
    }
  };
}
var isEntryPoint = process.argv[1] !== void 0 && import.meta.url === pathToFileURL(process.argv[1]).href;
if (isEntryPoint) {
  const root = process.env.CLAUDE_PLUGIN_ROOT;
  const data = process.env.CLAUDE_PLUGIN_DATA;
  if (!root || !data) {
    process.stdout.write(
      JSON.stringify({
        hookSpecificOutput: {
          hookEventName: "SessionStart",
          additionalContext: ""
        }
      })
    );
    process.exit(0);
  }
  runSessionStart({ root, data }).then((out) => {
    process.stdout.write(JSON.stringify(out));
    process.exit(0);
  }).catch(() => {
    process.stdout.write(
      JSON.stringify({
        hookSpecificOutput: {
          hookEventName: "SessionStart",
          additionalContext: ""
        }
      })
    );
    process.exit(0);
  });
}
export {
  runSessionStart
};
